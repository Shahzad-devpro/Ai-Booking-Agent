# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"

# AI Service (Groq)
GROQ_API_KEY="gsk_your_groq_api_key"

# Email Notifications (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="CoolAir HVAC <onboarding@resend.dev>"
BUSINESS_NOTIFICATION_EMAIL="owner@example.com"

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_URL="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173"
