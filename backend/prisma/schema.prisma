generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Technician {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  active    Boolean  @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  address      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  leads        Lead[]
}

model Lead {
  id                 String        @id @default(cuid())
  customerId         String
  service            String
  problemDescription String
  urgency            Urgency       @default(NORMAL)
  status             LeadStatus    @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointment        Appointment?
  conversation       Conversation?
  customer           Customer      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([urgency])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Appointment {
  id           String            @id @default(cuid())
  customerId   String
  leadId       String            @unique
  technicianId String?
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(BOOKED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id])
  lead       Lead        @relation(fields: [leadId], references: [id])
  technician   Technician?       @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([startTime])
  @@index([technicianId])
}

model Conversation {
  id        String    @id @default(cuid())
  leadId    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lead      Lead?     @relation(fields: [leadId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum LeadStatus {
  NEW
  AI_QUALIFIED
  CONTACTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LOST
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}
